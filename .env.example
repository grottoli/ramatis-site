# Endereço público final (usado nos links canônicos). Ex.: https://fraternidaderamatis.com
# Ao publicar, defina isto ANTES do build (make publicar): o Astro grava os links
# canônicos no momento do build.
SITE_URL=http://localhost:8088
PORTA_LOCAL=8088
# Token do túnel criado em Cloudflare Zero Trust > Networks > Tunnels (só para o profile "publico")
CLOUDFLARE_TUNNEL_TOKEN=
