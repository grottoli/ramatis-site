---
import type { Secao } from "../lib/acervo";
interface Props {
  anterior?: Secao;
  proxima?: Secao;
  variante?: "topo" | "fim";
}
const { anterior, proxima, variante = "fim" } = Astro.props;
const url = (s: Secao) => `/apostila/${s.data.apostila}/${s.data.secao}/`;
---
<nav class={`nav-secoes ${variante}`} aria-label="Navegação entre seções">
  {anterior ? (
    <a class="ns-link ns-ant" href={url(anterior)} rel="prev">
      <span class="ns-seta" aria-hidden="true">←</span>
      <span class="ns-texto">
        <span class="ns-rot">Seção anterior</span>
        <span class="ns-tit">{anterior.data.titulo}</span>
      </span>
    </a>
  ) : (
    <span class="ns-vazio"></span>
  )}

  {proxima ? (
    <a class="ns-link ns-prox" href={url(proxima)} rel="next">
      <span class="ns-texto">
        <span class="ns-rot">Próxima seção</span>
        <span class="ns-tit">{proxima.data.titulo}</span>
      </span>
      <span class="ns-seta" aria-hidden="true">→</span>
    </a>
  ) : (
    <a class="ns-link ns-prox ns-fim" href="/curso/">
      <span class="ns-texto">
        <span class="ns-rot">Fim da apostila</span>
        <span class="ns-tit">Voltar ao curso</span>
      </span>
      <span class="ns-seta" aria-hidden="true">→</span>
    </a>
  )}
</nav>
