---
import "../styles/global.css";
import site from "../data/site.json";
interface Props {
  titulo?: string;
  descricao?: string;
  secao?: "curso" | "sobre" | "busca" | "sobre-ramatis" | "obras" | "hemeroteca";
  tipo?: "website" | "article";
  imagem?: string;
}
const {
  titulo,
  descricao = site.descricaoSite,
  secao,
  tipo = "website",
  imagem = "/ramatis-medalhao.png",
} = Astro.props;
const tituloPagina = titulo ? `${titulo} — ${site.nome}` : `${site.nome} — ${site.lema}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemAbs = new URL(imagem, Astro.site);
const dadosEstruturados = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organizacao", Astro.site).href,
      name: site.nome,
      url: new URL("/", Astro.site).href,
      logo: imagemAbs.href,
      description: site.descricaoSite,
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#site", Astro.site).href,
      name: site.nome,
      url: new URL("/", Astro.site).href,
      inLanguage: "pt-BR",
      publisher: { "@id": new URL("/#organizacao", Astro.site).href },
    },
  ],
};
const links = [
  { href: "/sobre-ramatis/", rot: "Sobre Ramatís", id: "sobre-ramatis" },
  { href: "/curso/", rot: "Preparação 3º Milênio", id: "curso" },
  { href: "/obras/", rot: "Obras", id: "obras" },
  { href: "/hemeroteca/", rot: "Hemeroteca", id: "hemeroteca" },
  { href: "/busca/", rot: "Buscar", id: "busca" },
  { href: "/sobre/", rot: "Sobre", id: "sobre" },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1b1630" />

    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemAbs} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content={`Retrato psicopictografado de Ramatís — ${site.nome}`} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Ir para o conteúdo</a>
    <header class="topo">
      <a class="marca" href="/">
        <img class="marca-medalhao" src="/ramatis-medalhao.png" alt="" aria-hidden="true" width="44" height="44" />
        {site.nome}
      </a>
      <nav aria-label="Navegação principal">
        {links.map((l) => <a href={l.href} aria-current={secao === l.id ? "page" : undefined}>{l.rot}</a>)}
      </nav>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="rodape">
      <p>{site.origem}</p>
      <p class="rodape-nota">Iniciativa de divulgação sem fins comerciais. As obras completas de Ramatís permanecem a fonte a ser buscada por quem quiser se aprofundar.</p>
    </footer>
  </body>
</html>
