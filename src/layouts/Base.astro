---
import "../styles/global.css";
import site from "../data/site.json";
interface Props { titulo?: string; descricao?: string; secao?: "curso" | "sobre" | "busca" | "sobre-ramatis" | "obras" | "hemeroteca" }
const { titulo, descricao = site.descricaoSite, secao } = Astro.props;
const tituloPagina = titulo ? `${titulo} — ${site.nome}` : `${site.nome} — ${site.lema}`;
const links = [
  { href: "/sobre-ramatis/", rot: "Sobre Ramatís", id: "sobre-ramatis" },
  { href: "/curso/", rot: "Preparação 3º Milênio", id: "curso" },
  { href: "/obras/", rot: "Obras", id: "obras" },
  { href: "/hemeroteca/", rot: "Hemeroteca", id: "hemeroteca" },
  { href: "/busca/", rot: "Buscar", id: "busca" },
  { href: "/sobre/", rot: "Sobre", id: "sobre" },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#1b1630" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Ir para o conteúdo</a>
    <header class="topo">
      <a class="marca" href="/">
        <img class="marca-medalhao" src="/ramatis-medalhao.png" alt="" aria-hidden="true" width="44" height="44" />
        {site.nome}
      </a>
      <nav aria-label="Navegação principal">
        {links.map((l) => <a href={l.href} aria-current={secao === l.id ? "page" : undefined}>{l.rot}</a>)}
      </nav>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="rodape">
      <p>{site.origem}</p>
      <p class="rodape-nota">Iniciativa de divulgação sem fins comerciais. As obras completas de Ramatís permanecem a fonte a ser buscada por quem quiser se aprofundar.</p>
    </footer>
  </body>
</html>
